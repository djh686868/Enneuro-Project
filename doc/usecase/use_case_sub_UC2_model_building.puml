@startuml
' ============================================================
' 子用例图：模型构建 (UC2)
' 所属模块：基础功能模块
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam usecase {
    BorderColor #000000
    BackgroundColor #FFFFFF
}
skinparam actor {
    BorderColor #000000
    BackgroundColor #FFFFFF
}
skinparam rectangle {
    BorderColor #000000
    BackgroundColor #FFFFFF
}

top to bottom direction

actor "User（用户）" as User

rectangle "模型构建" {
    usecase "定义网络结构" as UC2_1
    usecase "配置层参数" as UC2_2
    usecase "设置连接方式" as UC2_3
    usecase "添加损失函数" as UC2_4
    usecase "配置优化器" as UC2_5
    usecase "构建计算图" as UC2_6
}

User --> UC2_1
User --> UC2_6

UC2_1 ..> UC2_2 : depends on
UC2_2 ..> UC2_3 : depends on
UC2_1 ..> UC2_4 : depends on
UC2_1 ..> UC2_5 : depends on
UC2_3 ..> UC2_6 : depends on
UC2_4 ..> UC2_6 : depends on
UC2_5 ..> UC2_6 : depends on

@enduml